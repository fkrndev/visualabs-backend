NODE_ENV=development

# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/vlabs
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vlabs
DB_POOL_SIZE=10

# Server Configuration
PORT=2024
NODE_ENV=development
TZ=Asia/Jakarta

# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL
FRONTEND_URL=http://localhost:2026

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3006/api/public/auth/google/callback
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Credential Vault — AES-256-GCM master key (>=32 char random).
# WAJIB di-set di production. JANGAN diubah setelah ada data tersimpan,
# karena semua secret lama akan gagal di-decrypt.
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# password
BYPASS_PASSWORD=zP9c0JJI04P+

#security
DISABLE_PASSWORD_HASHING=false
BCRYPT_COST=12

ENABLE_PERMISSION_SYSTEM=true
DEFAULT_ROLE_WHEN_DISABLED=1

ENABLE_CSP=true
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"

ENABLE_X_FRAME_OPTIONS=true
X_FRAME_OPTIONS=DENY

ENABLE_X_CONTENT_TYPE_OPTIONS=true
ENABLE_X_XSS_PROTECTION=true
ENABLE_REFERRER_POLICY=false
ENABLE_PERMISSIONS_POLICY=false
ENABLE_HSTS=false
ENABLE_REMOVE_SERVER=false
ENABLE_CACHE_CONTROL=false
ENABLE_XSS_PROTECTION=true
DISABLE_CSRF=false
ENABLE_RATE_LIMIT=false
ENABLE_ACCOUNT_LOCKOUT=false
ENABLE_SECURITY_LOGGING=false
ENABLE_SOFT_DELETE=false

# LLM Gateway (DeepSeek) — request LLM terpusat. Lihat docs/plan-agen/hermes.md.
DEEPSEEK_API_KEY=
# WAJIB diisi bersamaan dengan DEEPSEEK_API_KEY. Gate-nya hanya aktif kalau
# variabel ini terisi — tanpa itu /api/llm/v1 jadi proxy TERBUKA ke DeepSeek yang
# bisa dipakai siapa pun di internet dengan tagihan ke kita.
LLM_TEAM_TOKEN=
# DEEPSEEK_UPSTREAM_URL=https://api.deepseek.com/v1

# Gemini API — untuk Shopee Optimization (text + vision scoring).
# Dev: gemini-3.5-flash-lite (free tier 15 RPM, 500 RPD).
# Prod: ganti ke gemini-3.7-flash (Tier 1, lebih akurat).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Relay Hub — token node-agent buat register ke /api/relay/node (Fase 2).
RELAY_NODE_TOKEN=
# Per-node token (lebih aman, bisa revoke 1 node). JSON: {"node-a":"tokA","node-b":"tokB"}
# Kalau diset untuk sebuah node, dia dipakai; kalau tidak, fallback ke RELAY_NODE_TOKEN.
# RELAY_NODE_TOKENS=

# Distribusi Hermes Agent ke VBOX (lihat docs/plan-hermes/install-hermes.md).
# Config yang ditulis VBOX ke $HERMES_HOME setelah "Install Agent" selesai.
#
# Dua mode, ditentukan HERMES_LLM_PROVIDER:
#
#   custom   → Hermes diarahkan ke LLM Gateway kita (/api/llm/v1). Key DeepSeek
#              tidak pernah keluar dari server; laptop tim cuma dapat base_url +
#              LLM_TEAM_TOKEN. DISARANKAN. Wajib mengisi DEEPSEEK_API_KEY dan
#              LLM_TEAM_TOKEN di bawah.
#   deepseek → key asli disalin ke .env setiap laptop lewat HERMES_LLM_API_KEY.
#              Rotasi berarti menyentuh semua mesin.
HERMES_LLM_PROVIDER=custom
HERMES_LLM_MODEL=deepseek-chat
# Hanya dipakai mode `deepseek`. Biarkan kosong kalau memakai gateway.
HERMES_LLM_API_KEY=
# Hanya dipakai mode `custom`. Alamat gateway DARI LUAR (yang dilihat laptop tim),
# jadi tidak bisa diturunkan dari request masuk.
# HERMES_LLM_BASE_URL=https://vims.dots.my.id/api/llm/v1
# Folder tempat tarball + manifest.json hasil `bun run scripts/pack-hermes.ts`.
# Default: <cwd>/storage/hermes. Set kalau storage-nya di volume terpisah.
# HERMES_DIST_DIR=

# Google Drive — List Directory (lihat docs/plan-list-google-drive.md).
# Service account JSON. Pilih salah satu: path file (disarankan) ATAU isi JSON base64.
# File JANGAN ditaruh di dalam repo yang ter-track; folder `secrets/` sudah di-gitignore.
GOOGLE_DRIVE_SA_KEY_FILE=./secrets/drive-sa.json
# GOOGLE_DRIVE_SA_JSON=      # base64 dari isi service account JSON
# ID folder / Shared Drive yang jadi root tampilan.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Berapa detik hasil sync sebuah folder dianggap masih segar (hemat kuota Drive API).
DRIVE_SYNC_TTL_SECONDS=30
