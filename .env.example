# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/database_name
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dbxxx
DB_POOL_SIZE=10

# Server Configuration
PORT=3006
NODE_ENV=development

# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL
FRONTEND_URL=http://localhost:2026

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Master bypass login password (gunakan hanya untuk debugging / akses darurat)
# Contoh: g122D5:Ty\=B
BYPASS_PASSWORD=g122D5:Ty\=B

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3006/api/public/auth/google/callback
