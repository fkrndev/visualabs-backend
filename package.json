{
  "name": "app",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:critical": "vitest run tests/management-product/unit/services/product.service.test.ts tests/management-product/unit/services/pagination.service.test.ts tests/management-product/unit/services/search.service.test.ts",
    "test:high": "vitest run tests/management-product/unit/utils/validation.test.ts tests/management-product/unit/utils/error-handling.test.ts",
    "test:medium": "vitest run tests/management-product/integration/",
    "test:integration:products": "vitest run tests/management-product/integration/api/products.test.ts",
    "test:integration:pagination": "vitest run tests/management-product/integration/api/pagination.test.ts",
    "test:integration:search": "vitest run tests/management-product/integration/api/search.test.ts",
    "test:integration:bulk": "vitest run tests/management-product/integration/api/bulk-operations.test.ts",
    "test:integration:errors": "vitest run tests/management-product/integration/api/error-scenarios.test.ts",
    "test:component:management-product": "vitest run tests/management-product/component/",
    "test:management-product": "vitest run tests/management-product/",
    "test:unit:management-product": "vitest run tests/management-product/unit/",
    "test:integration:management-product": "vitest run tests/management-product/integration/",
    "test:subscription": "vitest run tests/subscription/",
    "test:subscription:unit": "vitest run tests/subscription/unit/",
    "test:subscription:integration": "vitest run tests/subscription/integration/",
    "test:subscription:component": "vitest run tests/subscription/component/",
    "test:subscription:watch": "vitest tests/subscription/",
    "test:subscription:coverage": "vitest run tests/subscription/ --coverage",
    "test:subscription:ui": "vitest --ui tests/subscription/",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.705.0",
    "@hono/zod-validator": "^0.7.2",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.7",
    "google-auth-library": "^10.5.0",
    "hono": "^4.9.6",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bun": "^1.2.21",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.6",
    "lodash-es": "^4.18.1",
    "prettier": "^3.6.2",
    "vitest": "^4.1.5"
  }
}
